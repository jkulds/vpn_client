<Application x:Class="SplitVpn.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:infra="clr-namespace:SplitVpn.Infrastructure"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Тема зафиксирована тёмной: SystemThemeWatcher намеренно не подключается. -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <infra:EnumLabelConverter x:Key="EnumLabel" />
            <infra:RouteTargetLabelConverter x:Key="TargetLabel" />
            <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
            <infra:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
            <infra:InverseBoolConverter x:Key="NotBool" />
            <infra:LatencyBrushConverter x:Key="LatencyBrush" />

            <!--
                Список с fallback: имена серверов из подписок содержат эмодзи, которых нет в Segoe UI.
                WPF рисует их монохромными - цветные слои COLR он не поддерживает.
            -->
            <FontFamily x:Key="EmojiFont">Segoe UI, Segoe UI Emoji, Segoe UI Symbol</FontFamily>

            <Style x:Key="GroupHeader" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Margin" Value="0,5,0,2" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>


            <!--
                Тема WPF-UI даёт элементам списка щедрые отступы: на списке из десятков
                серверов это съедает экран. BasedOn обязателен - без него подменится шаблон.
            -->
            <Style x:Key="CompactListItem" TargetType="ListBoxItem"
                   BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="Margin" Value="0,0,0,1" />
                <Setter Property="MinHeight" Value="0" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <!--
                Стилей для контролов WPF-UI здесь намеренно нет: Style без BasedOn подменяет
                дефолтный стиль вместе с ControlTemplate, а ключа {x:Type ui:TextBlock} в теме
                не существует, поэтому и BasedOn не спасает. Отступы задаются инлайном.
            -->
            <Style x:Key="SectionTitle" TargetType="ui:TextBlock">
                <Setter Property="FontTypography" Value="BodyStrong" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="12" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
