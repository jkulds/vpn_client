<ui:FluentWindow x:Class="SplitVpn.Views.RoutingWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Маршрутизация" Height="700" Width="1020"
                 MinHeight="520" MinWidth="820"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Маршрутизация">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Router24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="16,4,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0">

                <!-- ===== Приложения ===== -->
                <TabItem Header="Приложения">
                    <DockPanel Margin="4,12,4,4">
                        <ui:InfoBar DockPanel.Dock="Top" IsOpen="True" IsClosable="False" Severity="Informational"
                                    Margin="0,0,0,12"
                                    Message="Правила проверяются сверху вниз, срабатывает первое совпавшее. Правила приложений всегда имеют приоритет над гео-правилами." />

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon AppsList24}"
                                       Content="Из запущенных" Click="OnPickRunning" />
                            <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon Open24}"
                                       Content="Обзор .exe" Click="OnBrowseExe" />
                            <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon Add24}"
                                       Content="Пустое" Command="{Binding AddAppRuleCommand}" />
                            <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon Delete24}"
                                       Command="{Binding RemoveAppRuleCommand}" ToolTip="Удалить" />
                            <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon ArrowUp24}"
                                       Command="{Binding MoveAppRuleUpCommand}" ToolTip="Выше" />
                            <ui:Button Icon="{ui:SymbolIcon ArrowDown24}" Margin="0"
                                       Command="{Binding MoveAppRuleDownCommand}" ToolTip="Ниже" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding AppRules}"
                                  SelectedItem="{Binding SelectedAppRule}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  CellEditEnding="OnCellEdited">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Вкл" Width="48"
                                                        Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" />

                                <DataGridTemplateColumn Header="Совпадение по" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Mode, Converter={StaticResource EnumLabel}}"
                                                       VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedItem="{Binding Mode, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding DataContext.MatchModes,
                                                                   RelativeSource={RelativeSource AncestorType=Window}}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Процесс или путь" Binding="{Binding Value}" Width="*" />

                                <DataGridTemplateColumn Header="Куда" Width="165">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Target, Converter={StaticResource TargetLabel}}"
                                                       VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedItem="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding DataContext.AvailableTargets,
                                                                   RelativeSource={RelativeSource AncestorType=Window}}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource TargetLabel}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Заметка" Binding="{Binding Note}" Width="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- ===== Гео и домены ===== -->
                <TabItem Header="Гео, домены, IP">
                    <DockPanel Margin="4,12,4,4">
                        <ui:InfoBar DockPanel.Dock="Top" IsOpen="True" IsClosable="False" Severity="Informational"
                                    Margin="0,0,0,12"
                                    Message="GeoIP и GeoSite ядро качает как rule-set с обновлением раз в неделю. Значение - код набора: ru, cn, telegram, youtube, category-ads-all. Для сторонних списков укажите прямую ссылку на .srs." />

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon Add24}"
                                       Content="Добавить" Command="{Binding AddGeoRuleCommand}" />
                            <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon Delete24}"
                                       Command="{Binding RemoveGeoRuleCommand}" ToolTip="Удалить" />
                            <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon ArrowUp24}"
                                       Command="{Binding MoveGeoRuleUpCommand}" ToolTip="Выше" />
                            <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon ArrowDown24}"
                                       Command="{Binding MoveGeoRuleDownCommand}" ToolTip="Ниже" />
                            <ui:Button Icon="{ui:SymbolIcon Globe24}" Content="Пресет: РФ напрямую"
                                       Margin="0" Click="OnPresetRu" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding GeoRules}"
                                  SelectedItem="{Binding SelectedGeoRule}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  CellEditEnding="OnCellEdited">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Вкл" Width="48"
                                                        Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" />

                                <DataGridTemplateColumn Header="Тип" Width="185">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Kind, Converter={StaticResource EnumLabel}}"
                                                       VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding DataContext.GeoKinds,
                                                                   RelativeSource={RelativeSource AncestorType=Window}}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*" />

                                <DataGridTextColumn Header="Свой rule-set URL" Binding="{Binding CustomRuleSetUrl}" Width="190" />

                                <DataGridTemplateColumn Header="Куда" Width="165">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Target, Converter={StaticResource TargetLabel}}"
                                                       VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedItem="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding DataContext.AvailableTargets,
                                                                   RelativeSource={RelativeSource AncestorType=Window}}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource TargetLabel}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <ui:Button Grid.Row="1" Content="Закрыть" Appearance="Primary" MinWidth="110"
                       HorizontalAlignment="Right" Margin="0,12,0,0"
                       IsDefault="True" IsCancel="True" />
        </Grid>
    </Grid>
</ui:FluentWindow>
