<ui:FluentWindow x:Class="SplitVpn.Views.SubscriptionWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Новая подписка" Height="330" Width="580"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Новая подписка">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Cloud24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="18,8,18,18">
            <TextBlock Text="Название" Style="{StaticResource Caption}" Margin="0,0,0,5" />
            <ui:TextBox x:Name="NameBox" PlaceholderText="Название подписки" />

            <TextBlock Text="URL подписки" Style="{StaticResource Caption}" Margin="0,14,0,5" />
            <ui:TextBox x:Name="UrlBox" FontFamily="Cascadia Mono, Consolas"
                        PlaceholderText="https://..." Icon="{ui:SymbolIcon Link24}" />

            <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,16,0,0"
                        Message="Поддерживается список share-ссылок (текстом или base64) и JSON-конфиг sing-box. Clash YAML не поддерживается." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button Content="Добавить" Appearance="Primary" IsDefault="True" Click="OnOk"
                           MinWidth="110" Margin="0,0,8,0" />
                <ui:Button Content="Отмена" IsCancel="True" MinWidth="110" Margin="0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
