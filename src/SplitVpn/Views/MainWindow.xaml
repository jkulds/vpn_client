<ui:FluentWindow x:Class="SplitVpn.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:infra="clr-namespace:SplitVpn.Infrastructure"
                 Title="SplitVpn" Height="820" Width="1180"
                 Icon="pack://application:,,,/SplitVpn;component/Assets/app.ico"
                 MinHeight="620" MinWidth="960"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="SplitVpn - раздельное туннелирование">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="ShieldTask24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="10,2,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ Полоса подключения ============ -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="0" MinWidth="150" Height="40" FontWeight="SemiBold"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Play24}"
                               Content="Подключить"
                               Command="{Binding ConnectCommand}"
                               Visibility="{Binding IsRunning, Converter={StaticResource NotBoolToVis}}" />

                    <ui:Button Grid.Column="0" MinWidth="150" Height="40" FontWeight="SemiBold"
                               Appearance="Danger"
                               Icon="{ui:SymbolIcon Stop24}"
                               Content="Отключить"
                               Command="{Binding DisconnectCommand}"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PlugConnected24" FontSize="16" Margin="0,0,6,0"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                            <ui:SymbolIcon Symbol="PlugDisconnected24" FontSize="16" Margin="0,0,6,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding IsRunning, Converter={StaticResource NotBoolToVis}}" />
                            <ui:TextBlock Text="{Binding Status}" FontTypography="BodyStrong" />
                        </StackPanel>
                        <TextBlock Text="{Binding CoreVersion}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Beaker24}"
                                   Content="Проверить конфиг" Command="{Binding CheckConfigCommand}" />
                        <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Router24}"
                                   Content="Маршрутизация" Command="{Binding OpenRoutingCommand}" />
                        <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Folder24}"
                                   ToolTip="Папка данных" Command="{Binding OpenConfigFolderCommand}" />
                        <ui:Button Icon="{ui:SymbolIcon DocumentText24}" Margin="0"
                                   ToolTip="Папка логов" Command="{Binding OpenLogFolderCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--
                Оговорки сборки конфига: канал пущен напрямую или на подмене, сервер пропущен.
                В журнале такие строки тонут среди вывода ядра, а решают, куда идёт трафик.
            -->
            <ui:InfoBar Grid.Row="1" Margin="0,0,0,8"
                        Severity="Warning" Title="Конфиг собран с оговорками"
                        IsOpen="{Binding ShowConfigWarnings, Mode=TwoWay}"
                        Message="{Binding ConfigWarnings}" />

            <!-- ============ Две колонки ============ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" MinWidth="380" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" MinWidth="330" />
                </Grid.ColumnDefinitions>

                <!-- Левая: подписки и серверы -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <DockPanel>
                            <ui:TextBlock DockPanel.Dock="Top" Text="Подписки" Style="{StaticResource SectionTitle}" />

                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Add24}"
                                           Content="Добавить" Command="{Binding AddSubscriptionCommand}" />
                                <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon ArrowSync24}"
                                           Content="Обновить" Command="{Binding UpdateSelectedSubscriptionCommand}"
                                           ToolTip="Обновить выбранную подписку" />
                                <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon CloudSync24}"
                                           Content="Обновить все" Command="{Binding UpdateAllSubscriptionsCommand}" />
                                <ui:Button Icon="{ui:SymbolIcon Delete24}" Margin="0"
                                           Command="{Binding RemoveSubscriptionCommand}" ToolTip="Удалить подписку" />
                            </StackPanel>

                            <!-- GridView тема WPF-UI не оформляет, поэтому список на шаблонах. -->
                            <!-- Три подписки в высоту: при 88 px третья уже уезжала под прокрутку. -->
                            <ListBox ItemsSource="{Binding Settings.Subscriptions}"
                                     SelectedItem="{Binding SelectedSubscription}"
                                     Height="118"
                                     BorderThickness="0" Background="Transparent"
                                     ItemContainerStyle="{StaticResource CompactListItem}"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ui:SymbolIcon Grid.Column="0" Symbol="Cloud24" FontSize="15"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" />
                                            </StackPanel>

                                            <CheckBox Grid.Column="2" Content="авто" VerticalAlignment="Center"
                                                      IsChecked="{Binding AutoUpdate}"
                                                      ToolTip="Обновлять автоматически" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <ui:TextBlock Text="Серверы" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <CheckBox Content="группировать по подпискам" VerticalAlignment="Center"
                                              Margin="0,0,12,0"
                                              IsChecked="{Binding Settings.GroupProfilesBySubscription}" />
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}"
                                               Text="{Binding Settings.Profiles.Count, StringFormat=всего: {0}}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Link24}"
                                           Content="Импорт ссылок" Command="{Binding ImportLinksCommand}"
                                           ToolTip="Ссылки vless/vmess/trojan/ss/hysteria2 либо JSON-конфиг sing-box или Xray. Серверы попадут в группу, которую вы назовёте." />
                                <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon ArrowImport24}"
                                           Content="Из Happ" Command="{Binding ImportFromHappCommand}"
                                           ToolTip="Переносит правила маршрутизации из Happ. Серверы у Happ зашифрованы и не переносятся." />
                                <ui:Button Margin="0,0,6,0" Icon="{ui:SymbolIcon Pulse24}"
                                           Content="Проверить все" Command="{Binding CheckAllServersCommand}"
                                           ToolTip="Замер задержки через ядро по каждому серверу. Доступно только при запущенном подключении." />
                                <ui:Button Icon="{ui:SymbolIcon Delete24}" Margin="0"
                                           Command="{Binding RemoveProfileCommand}" ToolTip="Удалить сервер" />
                            </StackPanel>

                            <ListBox ItemsSource="{Binding ProfilesView}"
                                     SelectedItem="{Binding SelectedProfile}"
                                     IsSynchronizedWithCurrentItem="False"
                                     MinHeight="90"
                                     BorderThickness="0" Background="Transparent"
                                     ItemContainerStyle="{StaticResource CompactListItem}"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GroupItem">
                                                            <Expander Background="Transparent" BorderThickness="0"
                                                                      Padding="0" Margin="0,0,0,2"
                                                                      infra:GroupExpander.Key="{Binding Name}"
                                                                      infra:GroupExpander.Store="{Binding DataContext.GroupExpansion,
                                                                                                  RelativeSource={RelativeSource AncestorType=Window}}">
                                                                <Expander.Header>
                                                                    <TextBlock Style="{StaticResource GroupHeader}"
                                                                               FontFamily="{StaticResource EmojiFont}">
                                                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                                                        <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=({0})}" />
                                                                    </TextBlock>
                                                                </Expander.Header>
                                                                <ItemsPresenter />
                                                            </Expander>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    ToolTip="{Binding UnsupportedReason}">
                                            <ui:SymbolIcon Symbol="Server24" FontSize="14" Margin="0,0,6,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Visibility="{Binding IsSupported, Converter={StaticResource BoolToVis}}" />
                                            <ui:SymbolIcon Symbol="Warning24" FontSize="14" Margin="0,0,6,0"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                           Visibility="{Binding IsSupported, Converter={StaticResource NotBoolToVis}}" />
                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource EmojiFont}" />
                                            <TextBlock Text="{Binding UnsupportedReason, StringFormat=  - {0}}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding LatencyText}" VerticalAlignment="Center"
                                                       Margin="10,0,0,0" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding LatencyState, Converter={StaticResource LatencyBrush}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Правая: каналы и параметры -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <StackPanel>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ui:TextBlock Text="Каналы" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                           Text="Правила ссылаются на канал, а не на конкретный сервер. Меняете сервер в канале - правила остаются." />

                                <ItemsControl ItemsSource="{Binding Channels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="88" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <ui:TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                            Margin="0,0,6,0" />

                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding ProfilesView}"
                                                          SelectedItem="{Binding Selected}"
                                                          IsSynchronizedWithCurrentItem="False"
                                                          IsEnabled="{Binding ManualSelectionEnabled}"
                                                          MaxDropDownHeight="420"
                                                          Margin="0,0,6,0">
                                                    <ComboBox.GroupStyle>
                                                        <GroupStyle>
                                                            <GroupStyle.HeaderTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Name}"
                                                                               Style="{StaticResource GroupHeader}" />
                                                                </DataTemplate>
                                                            </GroupStyle.HeaderTemplate>
                                                        </GroupStyle>
                                                    </ComboBox.GroupStyle>
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Display}"
                                                                       FontFamily="{StaticResource EmojiFont}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <TextBlock Grid.Column="2" Text="{Binding Selected.LatencyText}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                                           FontSize="11" FontWeight="SemiBold" MinWidth="52"
                                                           TextAlignment="Right"
                                                           Foreground="{Binding Selected.LatencyState,
                                                                        Converter={StaticResource LatencyBrush}}" />

                                                <CheckBox Grid.Column="3" Content="авто" IsChecked="{Binding AutoFastest}"
                                                          VerticalAlignment="Center" Margin="0,0,6,0"
                                                          ToolTip="urltest: ядро само выбирает быстрейший сервер" />

                                                <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon Delete24}" Margin="0"
                                                           Command="{Binding DataContext.RemoveChannelCommand,
                                                                     RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}" ToolTip="Удалить канал" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ui:Button Icon="{ui:SymbolIcon Add24}" Content="Добавить канал"
                                           Command="{Binding AddChannelCommand}"
                                           HorizontalAlignment="Left" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ui:TextBlock Text="Маршрут по умолчанию" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                           Text="Куда идёт всё, что не попало ни в одно правило." />
                                <ComboBox ItemsSource="{Binding RouteTargetOptions}"
                                          SelectedItem="{Binding Settings.DefaultChannelName}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ui:TextBlock Text="Ядро и параметры" Style="{StaticResource SectionTitle}" />

                                <TextBlock Text="Путь к sing-box.exe" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                                <ui:TextBox Text="{Binding Settings.CorePath, UpdateSourceTrigger=LostFocus}"
                                            PlaceholderText="sing-box.exe" />
                                <TextBlock Text="{Binding CoreVersion}" Style="{StaticResource Caption}" Margin="0,4,0,0" />

                                <TextBlock Text="Путь к xray.exe" Style="{StaticResource Caption}" Margin="0,8,0,3"
                                           ToolTip="Нужен только для серверов из подписок в формате конфига Xray: XHTTP и балансировщики sing-box не умеет." />
                                <ui:TextBox Text="{Binding Settings.XrayPath, UpdateSourceTrigger=LostFocus}"
                                            PlaceholderText="xray.exe" />

                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="Блокировать QUIC (UDP/443)" VerticalAlignment="Center"
                                               ToolTip="QUIC не сниффится, из-за чего домен-правила не работают в Chrome." />
                                    <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Settings.BlockQuic}" />
                                </Grid>

                                <Grid Margin="0,7,0,0">
                                    <TextBlock Text="Только IPv4" VerticalAlignment="Center"
                                               ToolTip="IPv6 часто не завёрнут в туннель и течёт мимо правил." />
                                    <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Settings.Ipv4Only}" />
                                </Grid>

                                <Grid Margin="0,7,0,0">
                                    <TextBlock Text="Сворачивать в трей" VerticalAlignment="Center" />
                                    <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Settings.MinimizeToTray}" />
                                </Grid>

                                <Grid Margin="0,7,0,0">
                                    <TextBlock Text="Закрытие прячет в трей" VerticalAlignment="Center"
                                               TextWrapping="Wrap" MaxWidth="220" HorizontalAlignment="Left"
                                               ToolTip="Ядро продолжает работать. Полный выход - через меню значка в трее." />
                                    <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Settings.CloseToTray}" />
                                </Grid>

                                <Grid Margin="0,7,0,0"
                                      ToolTip="Замер идёт реальным запросом через туннель. 0 - не проверять.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Проверять каналы, сек" VerticalAlignment="Center" />
                                    <ui:TextBox Grid.Column="1" Text="{Binding Settings.ChannelCheckSeconds}" />
                                </Grid>

                                <Grid Margin="0,7,0,0">
                                    <TextBlock Text="Перезапуск после обновления подписки" VerticalAlignment="Center"
                                               TextWrapping="Wrap" MaxWidth="220" HorizontalAlignment="Left" />
                                    <ui:ToggleSwitch HorizontalAlignment="Right"
                                                     IsChecked="{Binding Settings.RestartAfterSubscriptionUpdate}" />
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Обновлять подписки, часов" VerticalAlignment="Center" />
                                    <ui:TextBox Grid.Column="1" Text="{Binding Settings.SubscriptionUpdateHours}" />
                                </Grid>

                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Локальный HTTP/SOCKS порт" VerticalAlignment="Center" />
                                    <ui:TextBox Grid.Column="1" Text="{Binding Settings.MixedPort}" />
                                </Grid>

                                <Grid Margin="0,7,0,0"
                                      ToolTip="На info ядро пишет каждый DNS-ответ и каждое соединение - десятки строк в секунду.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Журнал ядра" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding CoreLogLevels}"
                                              SelectedItem="{Binding Settings.CoreLogLevel}" />
                                </Grid>


                                <ui:Button Icon="{ui:SymbolIcon Save24}" Content="Сохранить"
                                           Command="{Binding SaveCommand}"
                                           HorizontalAlignment="Left" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ Журнал ============ -->
            <ui:CardExpander Grid.Row="3" Margin="0,2,0,0" IsExpanded="True" Padding="8">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="TextBulletListSquare24" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <ui:TextBlock Text="Журнал" FontTypography="BodyStrong" />
                </ui:CardExpander.Header>

                <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}"
                         IsReadOnly="True" Height="104"
                         FontFamily="Cascadia Mono, Consolas" FontSize="11"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </ui:CardExpander>
        </Grid>
    </Grid>
</ui:FluentWindow>
