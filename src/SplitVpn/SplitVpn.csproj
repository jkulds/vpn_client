<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SplitVpn</AssemblyName>
    <RootNamespace>SplitVpn</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFO0003: анализатор WinForms требует настраивать DPI своим API.
         Окон WinForms здесь нет, только NotifyIcon, а DPI задаёт манифест для WPF. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Тот же файл как ресурс: ApplicationIcon даёт значок exe, Window.Icon - значок в панели задач. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>


  <ItemGroup>
    <!-- WinForms нужен только ради NotifyIcon; в неявных using он конфликтует
         с System.Windows.Application из WPF. Импортируется точечно в TrayIcon. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
